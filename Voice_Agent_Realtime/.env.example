PORT=3210

# Azure OpenAI / Azure AI Foundry Realtime
AZURE_OPENAI_RESOURCE=your-resource-name
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2
AZURE_OPENAI_REALTIME_VOICE=alloy

# DefaultAzureCredential will use one of the available identity sources:
# - az login
# - Visual Studio / VS Code signed-in Azure account
# - Managed Identity when deployed to Azure
# Optional if your environment needs explicit tenant/subscription hints:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=

# Optional tuning
ASSISTANT_SYSTEM_PROMPT=You are a professional multilingual realtime assistant. Keep answers concise, grounded in tool results, and mention sources when available.
APP_TITLE=Voice_Agent_Realtime

# Optional content providers
# If omitted, news falls back to Hacker News Search and game guides fall back to Bing Search RSS.
NEWS_API_KEY=
NEWS_API_BASE_URL=https://gnews.io/api/v4
TAVILY_API_KEY=
